<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <RootNamespace>MDFileViewer.E2ETests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!-- 앱 어셈블리를 참조하지 않고 빌드 순서만 보장한다. E2E는 실제 exe를 별도 프로세스로 띄워 조작하기 때문이다. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\MDFileViewer\MDFileViewer.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- 화면 문구를 앱과 같은 상수(UiText)로 비교해, 문구를 바꿔도 테스트를 고치지 않게 한다 -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\MDFileViewer.Core\MDFileViewer.Core.csproj" />
  </ItemGroup>

  <!-- 테스트가 띄울 exe 경로를 빌드 시점에 어셈블리 메타데이터로 박아 둔다 (구성·대상 프레임워크가 바뀌어도 맞는 경로를 쓰도록) -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppExePath</_Parameter1>
      <_Parameter2>$(MSBuildThisFileDirectory)..\..\src\MDFileViewer\bin\$(Configuration)\$(TargetFramework)\MDFileViewer.exe</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="FlaUI.UIA3" Version="5.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

</Project>

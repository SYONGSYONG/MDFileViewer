<Project>

  <!-- 모든 프로젝트 공통 빌드 속성 (.claude/04-conventions.md §3.1) -->
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>1.0.0</Version>
    <Product>MDFileViewer</Product>
    <!-- exe 파일 속성의 저작권 (02 §15.2, MIT 라이선스 — 루트 LICENSE) -->
    <Authors>SYONG</Authors>
    <Company>SYONG</Company>
    <Copyright>Copyright (c) 2026 SYONG</Copyright>
  </PropertyGroup>

</Project>

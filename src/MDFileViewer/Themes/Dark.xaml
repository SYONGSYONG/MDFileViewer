<!--
  어둡게 테마 색 토큰 (.claude/03-design.md §4). Light.xaml과 같은 키를 쓰고, ThemeService가 런타임에 바꿔 끼운다.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Surface.Chrome" Color="#17191D" />
    <SolidColorBrush x:Key="Surface.Panel" Color="#1B1E23" />
    <SolidColorBrush x:Key="Surface.Document" Color="#1F2228" />
    <SolidColorBrush x:Key="Surface.Hover" Color="#272B33" />
    <SolidColorBrush x:Key="Surface.Selected" Color="#233552" />
    <SolidColorBrush x:Key="Border.Subtle" Color="#2C3038" />
    <SolidColorBrush x:Key="Border.Strong" Color="#454B56" />
    <SolidColorBrush x:Key="Text.Primary" Color="#E4E6EA" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#9AA3AF" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#5E6570" />
    <SolidColorBrush x:Key="Accent" Color="#6EA8FE" />
    <SolidColorBrush x:Key="Mode.Edit" Color="#F0A23B" />
    <SolidColorBrush x:Key="Status.Danger" Color="#FF7B72" />
    <SolidColorBrush x:Key="Status.Success" Color="#56D364" />
    <SolidColorBrush x:Key="Code.Background" Color="#262A31" />
    <SolidColorBrush x:Key="Quote.Bar" Color="#3A404B" />
</ResourceDictionary>

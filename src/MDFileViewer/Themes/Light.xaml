<!--
  밝게 테마 색 토큰 (.claude/03-design.md §4). viewer.css와 같은 이름·값을 쓴다.
  Phase 6에서 Dark.xaml을 같은 키로 만들고 런타임에 바꿔 끼우므로, 화면에서는 DynamicResource로 참조한다.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Surface.Chrome" Color="#F4F2EE" />
    <SolidColorBrush x:Key="Surface.Panel" Color="#EEEBE5" />
    <SolidColorBrush x:Key="Surface.Document" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Surface.Hover" Color="#E4E0D8" />
    <SolidColorBrush x:Key="Surface.Selected" Color="#DCE6F8" />
    <SolidColorBrush x:Key="Border.Subtle" Color="#DAD6CE" />
    <SolidColorBrush x:Key="Border.Strong" Color="#8C877D" />
    <SolidColorBrush x:Key="Text.Primary" Color="#1E2228" />
    <SolidColorBrush x:Key="Text.Secondary" Color="#5B6270" />
    <SolidColorBrush x:Key="Text.Disabled" Color="#9A9FA8" />
    <SolidColorBrush x:Key="Accent" Color="#2F6FDE" />
    <SolidColorBrush x:Key="Mode.Edit" Color="#C77700" />
    <SolidColorBrush x:Key="Status.Danger" Color="#C2382E" />
    <SolidColorBrush x:Key="Status.Success" Color="#1F7A44" />
    <SolidColorBrush x:Key="Code.Background" Color="#F4F1EA" />
    <SolidColorBrush x:Key="Quote.Bar" Color="#D3CDC1" />
    <SolidColorBrush x:Key="Find.Highlight" Color="#FFE27A" />
</ResourceDictionary>

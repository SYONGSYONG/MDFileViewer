<?xml version="1.0" encoding="utf-8"?>
<!--
  설치 파일용 발행 프로필 — 자체 포함, 폴더에 펼침 (02 §15.1). publish-setup.bat이 쓰고, Inno Setup(installer/setup.iss)이
  이 폴더를 통째로 설치 파일에 담는다.

  사용: dotnet publish src/MDFileViewer -p:PublishProfile=win-x64-folder
  결과: bin/Release/net10.0-windows/win-x64/publish-folder/

  - SelfContained: 대상 PC에 .NET을 설치하지 않는다 (01 §7).
  - 단일 파일이 아니므로 첫 실행 때 임시 폴더로 푸는 단계가 없다.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- 단일 exe 폴더(publish-singlefile)와 섞이지 않게 나눈다 -->
    <PublishDir>bin\Release\net10.0-windows\win-x64\publish-folder\</PublishDir>

    <!-- 곁다리 파일 줄이기: 디버그 기호를 빼고, 프레임워크 언어 리소스는 한국어·영어만 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>

    <!-- 참조 프로젝트(Core)의 .pdb·.xml이 따라오지 않게 한다. 프로필 속성은 ProjectReference로 전해지지 않으므로 따로 막는다. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>

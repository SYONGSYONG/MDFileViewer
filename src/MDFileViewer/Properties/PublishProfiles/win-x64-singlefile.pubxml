<?xml version="1.0" encoding="utf-8"?>
<!--
  포터블 발행 프로필 — 자체 포함 단일 exe (02 §15.1). publish-portable.bat이 쓴다.

  사용: dotnet publish src/MDFileViewer -p:PublishProfile=win-x64-singlefile
  결과: bin/Release/net10.0-windows/win-x64/publish-singlefile/MDFileViewer.exe

  - SelfContained: 대상 PC에 .NET을 설치하지 않는다 (01 §7).
  - IncludeNativeLibrariesForSelfExtract: WPF·WebView2 네이티브 DLL(WebView2Loader.dll 등)도 exe에 넣는다.
  - IncludeAllContentForSelfExtract: 앱이 viewer.html·viewer.css를 Resources 폴더의 실제 파일로 읽으므로(WebView2 가상 호스트, 02 §6.2)
    콘텐츠까지 exe에 넣고 첫 실행 때 임시 폴더로 풀게 한다. 이때 AppContext.BaseDirectory가 그 임시 폴더를 가리킨다.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <!-- 단일 exe 폴더와 설치 파일용 폴더(publish-folder)가 섞이지 않게 나눈다 -->
    <PublishDir>bin\Release\net10.0-windows\win-x64\publish-singlefile\</PublishDir>

    <!-- 곁다리 파일 줄이기: 디버그 기호를 빼고, 프레임워크 언어 리소스는 한국어·영어만 -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>

    <!-- 참조 프로젝트(Core)의 .pdb·.xml이 따라오지 않게 한다. 프로필 속성은 ProjectReference로 전해지지 않으므로 따로 막는다. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>
</Project>

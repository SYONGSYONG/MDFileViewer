<!--
  메인 창 (.claude/03-design.md §2.1·§2.2·§3): 툴바 40px, [트리 | 탭 줄 + (편집기 | 뷰어)], 상태 표시줄 26px.
  편집 모드에서는 툴바 아래 2px 편집 막대, 트리를 접은 24px 줄, 편집기 열이 나타난다(열 너비는 코드 숨김이 바꾼다).
  색은 테마 토큰(DynamicResource), 문구는 Core UiText(x:Static)를 쓴다.
-->
<Window x:Class="MDFileViewer.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:MDFileViewer.Core;assembly=MDFileViewer.Core"
        xmlns:models="clr-namespace:MDFileViewer.Core.Models;assembly=MDFileViewer.Core"
        xmlns:vm="clr-namespace:MDFileViewer.Core.ViewModels;assembly=MDFileViewer.Core"
        xmlns:controls="clr-namespace:MDFileViewer.Controls"
        xmlns:themes="clr-namespace:MDFileViewer.Themes"
        xmlns:avalon="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="{Binding Title}"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="1440" Height="900"
        MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Surface.Chrome}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{StaticResource Font.Ui}" FontSize="13"
        AllowDrop="True" PreviewDragEnter="OnPreviewDragOver" PreviewDragOver="OnPreviewDragOver" PreviewDrop="OnPreviewDrop"
        AutomationProperties.AutomationId="MainWindow">

    <Window.Resources>
        <controls:TreeNodeGlyphConverter x:Key="TreeNodeGlyph" />
        <controls:NullToVisibilityConverter x:Key="NullToVisibility" />
        <controls:BoolToVisibilityConverter x:Key="BoolToVisibility" />
        <controls:OutlineIndentConverter x:Key="OutlineIndent" />

        <!-- 상태 표시줄 한 칸: 왼쪽 1px 구분선. 값이 없으면 칸째로 접는다 -->
        <Style x:Key="StatusSegment" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource Border.Subtle}" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Margin" Value="0,5" />
        </Style>

        <HierarchicalDataTemplate DataType="{x:Type vm:TreeNodeViewModel}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="Icon" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,6,0"
                           Foreground="{DynamicResource Text.Secondary}">
                    <TextBlock.Text>
                        <MultiBinding Converter="{StaticResource TreeNodeGlyph}">
                            <Binding Path="Kind" />
                            <Binding Path="IsExpanded" />
                            <Binding Path="Access" />
                        </MultiBinding>
                    </TextBlock.Text>
                </TextBlock>
                <TextBlock x:Name="Label" Text="{Binding DisplayName}" VerticalAlignment="Center" />
            </StackPanel>
            <HierarchicalDataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPlaceholder}" Value="True">
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                </DataTrigger>
            </HierarchicalDataTemplate.Triggers>
        </HierarchicalDataTemplate>

        <!-- 문서 탭 하나 (03 §2.1): 높이 32, 최대 220, 활성 탭은 문서 면 색 + 위 2px Accent, 미리보기 탭은 기울임, 변경은 ● -->
        <DataTemplate x:Key="DocumentTabTemplate" DataType="{x:Type vm:DocumentTabViewModel}">
            <Border x:Name="TabChrome" Height="32" MaxWidth="220" Padding="12,0,8,0" Background="Transparent"
                    BorderBrush="{DynamicResource Accent}" BorderThickness="0,2,0,0"
                    ToolTip="{Binding FilePath}" Cursor="Hand"
                    MouseLeftButtonDown="OnTabMouseLeftButtonDown" MouseUp="OnTabMouseUp" ContextMenuOpening="OnTabContextMenuOpening">
                <Border.ContextMenu>
                    <ContextMenu />
                </Border.ContextMenu>
                <DockPanel VerticalAlignment="Center">
                    <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource TabCloseButton}" Visibility="Hidden"
                            Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                            CommandParameter="{Binding}" ToolTip="{x:Static core:UiText.CloseTabToolTip}"
                            AutomationProperties.Name="{x:Static core:UiText.CloseButton}" AutomationProperties.AutomationId="CloseTabButton">
                        <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="{x:Static themes:IconGlyphs.Close}" />
                    </Button>
                    <TextBlock x:Name="DirtyMark" DockPanel.Dock="Right" Text="●" Margin="4,0,0,0" FontSize="10"
                               VerticalAlignment="Center" Foreground="{DynamicResource Status.Danger}"
                               Visibility="{Binding IsDirty, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock x:Name="TabName" Text="{Binding FileName}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Secondary}" AutomationProperties.AutomationId="DocumentTabName" />
                </DockPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="TabChrome" Property="BorderBrush" Value="Transparent" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource Surface.Document}" />
                    <Setter TargetName="TabName" Property="Foreground" Value="{DynamicResource Text.Primary}" />
                    <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPreview}" Value="True">
                    <Setter TargetName="TabName" Property="FontStyle" Value="Italic" />
                </DataTrigger>
                <Trigger SourceName="TabChrome" Property="IsMouseOver" Value="True">
                    <Setter TargetName="CloseButton" Property="Visibility" Value="Visible" />
                </Trigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsActive}" Value="False" />
                        <Condition Binding="{Binding IsMouseOver, ElementName=TabChrome}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="TabChrome" Property="Background" Value="{DynamicResource Surface.Hover}" />
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenFolderCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Key="E" Modifiers="Control" Command="{Binding ToggleEditCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
        <KeyBinding Key="B" Modifiers="Control" Command="{Binding ToggleNavigationPanelCommand}" />
        <KeyBinding Key="B" Modifiers="Control+Shift" Command="{Binding Outline.ToggleCommand}" />
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseActiveTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control" Command="{Binding NextTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Control+Shift" Command="{Binding PreviousTabCommand}" />
        <KeyBinding Key="OemPlus" Modifiers="Control" Command="{Binding Zoom.ZoomInCommand}" />
        <KeyBinding Key="Add" Modifiers="Control" Command="{Binding Zoom.ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Modifiers="Control" Command="{Binding Zoom.ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Modifiers="Control" Command="{Binding Zoom.ZoomOutCommand}" />
        <KeyBinding Key="F" Modifiers="Control" Command="{Binding Find.OpenCommand}" />
        <KeyBinding Key="F3" Command="{Binding Find.NextCommand}" />
        <KeyBinding Key="F3" Modifiers="Shift" Command="{Binding Find.PreviousCommand}" />
        <KeyBinding Key="D0" Modifiers="Control" Command="{Binding Zoom.ResetCommand}" />
        <KeyBinding Key="NumPad0" Modifiers="Control" Command="{Binding Zoom.ResetCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- 툴바 (03 §3): 폴더 열기 · 주소 · [편집][저장●] │ [-] 100% [+] │ [테마][?][릴리즈 노트][…]. 오른쪽에 붙는 요소는 먼저 쓴 것이 가장 오른쪽이다 -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,0" LastChildFill="True">
                <Button x:Name="MoreButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Click="OnMoreClick"
                        ToolTip="{x:Static core:UiText.MoreToolTip}" AutomationProperties.Name="{x:Static core:UiText.MoreToolTip}"
                        AutomationProperties.AutomationId="MoreButton">
                    <TextBlock Style="{StaticResource IconText}" Text="{x:Static themes:IconGlyphs.More}" />
                    <Button.ContextMenu>
                        <ContextMenu>
                            <!-- 창 하나로 열기 (01 F-23). 누르면 체크가 바뀌고 바로 저장한다 — 다음 실행부터 적용 -->
                            <MenuItem x:Name="SingleWindowMenuItem" Header="{x:Static core:UiText.SingleWindowMenu}" IsCheckable="True"
                                      Click="OnSingleWindowClick" ToolTip="{x:Static core:UiText.SingleWindowToolTip}"
                                      AutomationProperties.AutomationId="SingleWindowMenuItem" />
                            <Separator />
                            <MenuItem Header="{x:Static core:UiText.RegisterShellMenu}" Click="OnRegisterShellClick" AutomationProperties.AutomationId="RegisterShellMenuItem" />
                            <MenuItem Header="{x:Static core:UiText.UnregisterShellMenu}" Click="OnUnregisterShellClick" AutomationProperties.AutomationId="UnregisterShellMenuItem" />
                            <Separator />
                            <MenuItem Header="{x:Static core:UiText.AboutMenu}" Click="OnAboutClick" AutomationProperties.AutomationId="AboutMenuItem" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <!-- 릴리즈 노트 (01 F-24) — 도움말 버튼 바로 오른쪽 -->
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Click="OnReleaseNotesClick"
                        ToolTip="{x:Static core:UiText.ReleaseNotesToolTip}" AutomationProperties.Name="{x:Static core:UiText.ReleaseNotesToolTip}"
                        AutomationProperties.AutomationId="ReleaseNotesButton">
                    <TextBlock Style="{StaticResource IconText}" Text="{x:Static themes:IconGlyphs.ReleaseNotes}" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Click="OnHelpClick"
                        ToolTip="{x:Static core:UiText.HelpToolTip}" AutomationProperties.Name="{x:Static core:UiText.HelpToolTip}"
                        AutomationProperties.AutomationId="HelpButton">
                    <TextBlock Style="{StaticResource IconText}" Text="{x:Static themes:IconGlyphs.Help}" />
                </Button>
                <Button x:Name="ThemeButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Click="OnThemeClick"
                        ToolTip="{x:Static core:UiText.ThemeToolTip}" AutomationProperties.Name="{x:Static core:UiText.ThemeToolTip}"
                        AutomationProperties.AutomationId="ThemeButton">
                    <TextBlock Style="{StaticResource IconText}" Text="{x:Static themes:IconGlyphs.Theme}" />
                    <Button.ContextMenu>
                        <!-- 버튼 클릭으로 코드에서 여는(IsOpen) 메뉴는 DataContext를 물려받지 못해 항목 명령이 비었다(2026-11-18).
                             열기 직전에 정하는 PlacementTarget(버튼)에서 가져온다. -->
                        <ContextMenu DataContext="{Binding PlacementTarget.DataContext.Theme, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="{x:Static core:UiText.ThemeSystem}" IsCheckable="False" IsChecked="{Binding IsSystemSelected, Mode=OneWay}"
                                      Command="{Binding SelectModeCommand}" CommandParameter="{x:Static models:ThemeMode.System}" />
                            <MenuItem Header="{x:Static core:UiText.ThemeLight}" IsCheckable="False" IsChecked="{Binding IsLightSelected, Mode=OneWay}"
                                      Command="{Binding SelectModeCommand}" CommandParameter="{x:Static models:ThemeMode.Light}" />
                            <MenuItem Header="{x:Static core:UiText.ThemeDark}" IsCheckable="False" IsChecked="{Binding IsDarkSelected, Mode=OneWay}"
                                      Command="{Binding SelectModeCommand}" CommandParameter="{x:Static models:ThemeMode.Dark}" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <!-- 목차 패널 여닫기 (01 F-21, 03 §2.6). 열어 둔 상태는 눌린 모양으로 보인다 -->
                <Button DockPanel.Dock="Right" Command="{Binding Outline.ToggleCommand}"
                        ToolTip="{x:Static core:UiText.OutlineToolTip}" AutomationProperties.Name="{x:Static core:UiText.OutlineToolTip}"
                        AutomationProperties.AutomationId="OutlineButton">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Outline.IsPanelOpen}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock Style="{StaticResource IconText}" Text="{x:Static themes:IconGlyphs.Outline}" />
                </Button>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSeparator}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Command="{Binding Zoom.ZoomInCommand}"
                        ToolTip="{x:Static core:UiText.ZoomInToolTip}" AutomationProperties.Name="{x:Static core:UiText.ZoomInToolTip}"
                        AutomationProperties.AutomationId="ZoomInButton">
                    <TextBlock Style="{StaticResource IconText}" Text="{x:Static themes:IconGlyphs.ZoomIn}" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarTextButton}" Command="{Binding Zoom.ResetCommand}" MinWidth="48"
                        ToolTip="{x:Static core:UiText.ZoomResetToolTip}" AutomationProperties.AutomationId="ZoomResetButton">
                    <TextBlock Text="{Binding Zoom.PercentText}" AutomationProperties.AutomationId="ZoomPercentText" />
                </Button>
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Command="{Binding Zoom.ZoomOutCommand}"
                        ToolTip="{x:Static core:UiText.ZoomOutToolTip}" AutomationProperties.Name="{x:Static core:UiText.ZoomOutToolTip}"
                        AutomationProperties.AutomationId="ZoomOutButton">
                    <TextBlock Style="{StaticResource IconText}" Text="{x:Static themes:IconGlyphs.ZoomOut}" />
                </Button>
                <Border DockPanel.Dock="Right" Style="{StaticResource ToolbarSeparator}" />
                <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Command="{Binding SaveCommand}"
                        Visibility="{Binding Document.IsEditing, Converter={StaticResource BoolToVisibility}}"
                        ToolTip="{x:Static core:UiText.SaveToolTip}" AutomationProperties.Name="{x:Static core:UiText.SaveToolTip}"
                        AutomationProperties.AutomationId="SaveButton">
                    <Grid>
                        <TextBlock Style="{StaticResource IconText}" Text="{x:Static themes:IconGlyphs.Save}" />
                        <Ellipse Width="7" Height="7" Margin="0,-2,-4,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Fill="{DynamicResource Status.Danger}"
                                 Visibility="{Binding Tabs.ActiveTab.IsDirty, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}" />
                    </Grid>
                </Button>
                <Button x:Name="EditToggle" DockPanel.Dock="Right" Command="{Binding ToggleEditCommand}"
                        ToolTip="{x:Static core:UiText.EditModeToolTip}" AutomationProperties.AutomationId="EditToggleButton">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarTextButton}">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Content">
                                <Setter.Value>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" FontSize="14" Margin="0,0,6,0" Text="{x:Static themes:IconGlyphs.Edit}" />
                                        <TextBlock Text="{x:Static core:UiText.EditButton}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Setter.Value>
                            </Setter>
                            <Setter Property="AutomationProperties.Name" Value="{x:Static core:UiText.EditButton}" />
                            <Style.Triggers>
                                <!-- 편집 중: Mode.Edit 틴트 + 아래 2px Mode.Edit (03 §8) -->
                                <DataTrigger Binding="{Binding Document.IsEditing}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Mode.Edit}" />
                                    <Setter Property="BorderThickness" Value="0,0,0,2" />
                                    <Setter Property="Background" Value="{DynamicResource Surface.Hover}" />
                                    <Setter Property="Content" Value="{x:Static core:UiText.ViewButton}" />
                                    <Setter Property="AutomationProperties.Name" Value="{x:Static core:UiText.ViewButton}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <!-- 탐색 패널 접기/펴기 (2026-11-18 사용자 요청) — Ctrl+B와 같은 명령 -->
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Command="{Binding ToggleNavigationPanelCommand}"
                        ToolTip="{x:Static core:UiText.ToggleNavigationToolTip}" AutomationProperties.Name="{x:Static core:UiText.ToggleNavigationToolTip}"
                        AutomationProperties.AutomationId="ToggleNavigationButton">
                    <TextBlock Style="{StaticResource IconText}" Text="{x:Static themes:IconGlyphs.NavigationPanel}" />
                </Button>
                <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}"
                        Command="{Binding OpenFolderCommand}"
                        ToolTip="{x:Static core:UiText.OpenFolderToolTip}"
                        AutomationProperties.Name="{x:Static core:UiText.OpenFolderTitle}"
                        AutomationProperties.AutomationId="OpenFolderButton">
                    <TextBlock Style="{StaticResource IconText}" Text="{x:Static themes:IconGlyphs.OpenFolder}" />
                </Button>
                <TextBox x:Name="AddressBox" Style="{StaticResource AddressBox}" Margin="8,0,12,0"
                         Text="{Binding AddressText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="{x:Static core:UiText.AddressBoxToolTip}"
                         AutomationProperties.Name="{x:Static core:UiText.AddressBoxName}"
                         AutomationProperties.AutomationId="AddressBox">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Return" Command="{Binding NavigateAddressCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
            </DockPanel>
        </Border>

        <!-- 편집 모드 막대 (03 §2.2·§8) -->
        <Border Grid.Row="1" Height="2" Background="{DynamicResource Mode.Edit}"
                Visibility="{Binding Document.IsEditing, Converter={StaticResource BoolToVisibility}}"
                AutomationProperties.AutomationId="EditModeBar" />

        <Grid x:Name="BodyGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="CollapsedNavigationColumn" Width="0" />
                <ColumnDefinition x:Name="TreeColumn" Width="320" MinWidth="160" />
                <ColumnDefinition x:Name="TreeSplitterColumn" Width="6" />
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition x:Name="OutlineSplitterColumn" Width="0" />
                <ColumnDefinition x:Name="OutlineColumn" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- 접힌 탐색 패널 (03 §2.2): 누르거나 Ctrl+B로 트리를 편다 -->
            <Button Grid.Column="0" Style="{StaticResource ToolbarButton}" Width="24" Height="Auto" VerticalAlignment="Stretch"
                    Background="{DynamicResource Surface.Panel}" Command="{Binding ToggleNavigationPanelCommand}"
                    ToolTip="{x:Static core:UiText.ExpandNavigationToolTip}"
                    AutomationProperties.Name="{x:Static core:UiText.ExpandNavigationToolTip}"
                    AutomationProperties.AutomationId="ExpandNavigationButton">
                <TextBlock Style="{StaticResource IconText}" FontSize="12" VerticalAlignment="Top" Margin="0,10,0,0"
                           Text="{x:Static themes:IconGlyphs.ChevronRight}" />
            </Button>

            <!-- 트리 (01 F-02·F-03·F-16): 즐겨찾기 · 내 PC. 하위 폴더가 수만 개인 폴더(예: WinSxS)도 멈추지 않도록 가상화한다 -->
            <TreeView x:Name="FolderTree" Grid.Column="1"
                      ItemsSource="{Binding Tree.Roots}"
                      Background="{DynamicResource Surface.Panel}" Foreground="{DynamicResource Text.Primary}"
                      BorderThickness="0" Padding="0,4"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Standard"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      AutomationProperties.Name="{x:Static core:UiText.FolderTreeName}"
                      AutomationProperties.AutomationId="FolderTree">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource FolderTreeItem}">
                        <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                        <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                        <!-- 클릭·키보드로 포커스를 받으면 WPF가 항목 전체를 보이게 하려고 가로로 크게 민다 — 가로채서 세로로만 맞춘다 (03 §2.1) -->
                        <EventSetter Event="RequestBringIntoView" Handler="OnTreeItemRequestBringIntoView" />
                        <!-- md 파일 더블클릭은 고정 탭 (01 F-03·F-17), 우클릭 메뉴는 노드 종류마다 다르다 (01 F-02) -->
                        <EventSetter Event="MouseDoubleClick" Handler="OnTreeItemMouseDoubleClick" />
                        <EventSetter Event="ContextMenuOpening" Handler="OnTreeItemContextMenuOpening" />
                        <Setter Property="ContextMenu">
                            <Setter.Value>
                                <ContextMenu />
                            </Setter.Value>
                        </Setter>
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </TreeView.ItemContainerStyle>
            </TreeView>

            <GridSplitter x:Name="TreeSplitter" Grid.Column="2" Style="{StaticResource PaneSplitter}" />

            <Grid Grid.Column="3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 찾기 줄 (01 F-20, 03 §2.5). WebView2(HwndHost) 위에는 겹쳐 띄울 수 없어 탭 줄과 문서 사이에 한 줄로 끼운다 -->
                <Border Grid.Row="1" Height="36" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1"
                        Visibility="{Binding Find.IsOpen, Converter={StaticResource BoolToVisibility}}"
                        AutomationProperties.AutomationId="FindBar">
                    <DockPanel Margin="12,0,8,0" LastChildFill="False">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}" Width="28" Height="28"
                                Command="{Binding Find.CloseCommand}"
                                ToolTip="{x:Static core:UiText.FindCloseToolTip}" AutomationProperties.Name="{x:Static core:UiText.FindCloseToolTip}"
                                AutomationProperties.AutomationId="FindCloseButton">
                            <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="{x:Static themes:IconGlyphs.Close}" />
                        </Button>
                        <TextBox x:Name="FindBox" DockPanel.Dock="Left" Style="{StaticResource AddressBox}" Width="280"
                                 Text="{Binding Find.Term, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="{x:Static core:UiText.FindBoxToolTip}"
                                 AutomationProperties.Name="{x:Static core:UiText.FindBoxName}"
                                 AutomationProperties.AutomationId="FindBox">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding Find.NextCommand}" />
                                <KeyBinding Key="Return" Modifiers="Shift" Command="{Binding Find.PreviousCommand}" />
                                <KeyBinding Key="Escape" Command="{Binding Find.CloseCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock DockPanel.Dock="Left" Margin="10,0" MinWidth="56" FontSize="12" VerticalAlignment="Center"
                                   Text="{Binding Find.StatusText}" AutomationProperties.AutomationId="FindStatusText">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource Text.Secondary}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Find.HasNoMatches}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource Status.Danger}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Width="28" Height="28"
                                Command="{Binding Find.PreviousCommand}"
                                ToolTip="{x:Static core:UiText.FindPreviousToolTip}" AutomationProperties.Name="{x:Static core:UiText.FindPreviousToolTip}"
                                AutomationProperties.AutomationId="FindPreviousButton">
                            <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{x:Static themes:IconGlyphs.ChevronUp}" />
                        </Button>
                        <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Width="28" Height="28"
                                Command="{Binding Find.NextCommand}"
                                ToolTip="{x:Static core:UiText.FindNextToolTip}" AutomationProperties.Name="{x:Static core:UiText.FindNextToolTip}"
                                AutomationProperties.AutomationId="FindNextButton">
                            <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{x:Static themes:IconGlyphs.ChevronDown}" />
                        </Button>
                    </DockPanel>
                </Border>

                <!-- 탭 줄 (01 F-17, 03 §2.1). 탭이 없으면 접는다. 넘치면 휠로 가로 스크롤 -->
                <Border Grid.Row="0" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,0,0,1"
                        Visibility="{Binding Tabs.HasTabs, Converter={StaticResource BoolToVisibility}}">
                    <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                  PreviewMouseWheel="OnTabStripMouseWheel">
                        <ItemsControl x:Name="TabStrip" ItemsSource="{Binding Tabs.Tabs}" ItemTemplate="{StaticResource DocumentTabTemplate}"
                                      AutomationProperties.Name="{x:Static core:UiText.TabStripName}" AutomationProperties.AutomationId="TabStrip">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <!-- 문서 영역: [편집기][구분선][뷰어]. 보기 모드는 편집기 열과 구분선을 접는다 (02 §17.1 뷰어는 하나) -->
                <Grid x:Name="DocumentGrid" Grid.Row="2" Background="{DynamicResource Surface.Document}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="EditorColumn" Width="0" />
                        <ColumnDefinition x:Name="EditorSplitterColumn" Width="0" />
                        <ColumnDefinition x:Name="ViewerColumn" Width="*" />
                    </Grid.ColumnDefinitions>

                    <avalon:TextEditor x:Name="Editor" Grid.Column="0" Visibility="Collapsed"
                                       FontFamily="Cascadia Mono, Consolas, Malgun Gothic" FontSize="14"
                                       Background="{DynamicResource Surface.Document}" Foreground="{DynamicResource Text.Primary}"
                                       LineNumbersForeground="{DynamicResource Text.Disabled}" Padding="8,4,0,0"
                                       ShowLineNumbers="True" WordWrap="True"
                                       AutomationProperties.Name="{x:Static core:UiText.EditorName}"
                                       AutomationProperties.AutomationId="Editor" />

                    <GridSplitter x:Name="EditorSplitter" Grid.Column="1" Style="{StaticResource PaneSplitter}" Visibility="Collapsed" />

                    <!-- 뷰어 (01 F-04). WebView2(HwndHost) 위에는 WPF 요소를 겹칠 수 없어, 안내는 WebView2를 숨기고 그 자리에 보여 준다 -->
                    <Grid Grid.Column="2">
                        <controls:MarkdownView x:Name="DocumentViewer"
                                               Visibility="{Binding Document.IsDocumentVisible, Converter={StaticResource BoolToVisibility}, ConverterParameter={x:Static controls:VisibilityParameters.Hidden}}"
                                               AutomationProperties.Name="{x:Static core:UiText.DocumentViewName}"
                                               AutomationProperties.AutomationId="DocumentViewer" />
                        <StackPanel MaxWidth="420" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding Document.IsDocumentVisible, Converter={StaticResource BoolToVisibility}, ConverterParameter={x:Static controls:VisibilityParameters.Invert}}">
                            <TextBlock Style="{StaticResource PlaceholderTitle}" Text="{Binding Document.Message}"
                                       AutomationProperties.AutomationId="DocumentMessage" />
                            <TextBlock Style="{StaticResource PlaceholderHint}" Text="{Binding Document.MessageHint}"
                                       Visibility="{Binding Document.MessageHint, Converter={StaticResource NullToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
            <GridSplitter x:Name="OutlineSplitter" Grid.Column="4" Style="{StaticResource PaneSplitter}" Visibility="Collapsed" />

            <!-- 목차 패널 (01 F-21, 03 §2.6). 보기 모드에서 문서가 보일 때만 편다(열 너비는 코드 숨김이 바꾼다) -->
            <Border x:Name="OutlinePanel" Grid.Column="5" Background="{DynamicResource Surface.Panel}" Visibility="Collapsed">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Margin="12,10,12,6" FontSize="12" Foreground="{DynamicResource Text.Secondary}"
                               Text="{x:Static core:UiText.OutlineTitle}" />
                    <TextBlock DockPanel.Dock="Top" Margin="12,6" Foreground="{DynamicResource Text.Secondary}"
                               Text="{x:Static core:UiText.OutlineEmpty}"
                               Visibility="{Binding Outline.IsEmpty, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.AutomationId="OutlineEmptyText" />
                    <ListBox x:Name="OutlineList" ItemsSource="{Binding Outline.Headings}"
                             Background="Transparent" Foreground="{DynamicResource Text.Primary}" BorderThickness="0" Padding="0,0,0,8"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnOutlineSelectionChanged"
                             AutomationProperties.Name="{x:Static core:UiText.OutlineListName}" AutomationProperties.AutomationId="OutlineList">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="MinHeight" Value="26" />
                                <Setter Property="Padding" Value="12,2,8,2" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                                <EventSetter Event="MouseLeftButtonUp" Handler="OnOutlineItemMouseUp" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:OutlineHeading}">
                                <TextBlock x:Name="HeadingTitle" Text="{Binding Title}" ToolTip="{Binding Title}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="{Binding Level, Converter={StaticResource OutlineIndent}}" />
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="1">
                                        <Setter TargetName="HeadingTitle" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- 상태 표시줄 (03 §2.1·§2.2): [편집 중] │ 경로 │ 인코딩 │ 줄 끝 │ 크기 │ 수정 시각 │ 안내 │ 커서 위치 -->
        <Border Grid.Row="3" BorderBrush="{DynamicResource Border.Subtle}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Left" Margin="8,4,0,4" Padding="8,0" CornerRadius="3" BorderThickness="1"
                        BorderBrush="{DynamicResource Mode.Edit}"
                        Visibility="{Binding Document.IsEditing, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{x:Static core:UiText.EditingBadge}" FontSize="12" VerticalAlignment="Center"
                               Foreground="{DynamicResource Text.Primary}" AutomationProperties.AutomationId="EditingBadge" />
                </Border>
                <TextBlock x:Name="CursorPositionText" DockPanel.Dock="Right" Style="{StaticResource StatusText}"
                           Visibility="{Binding Document.IsEditing, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.AutomationId="CursorPositionText" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource StatusText}" MaxWidth="560" Text="{Binding StatusMessage}"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}"
                               AutomationProperties.AutomationId="StatusMessage" />
                    <TextBlock Style="{StaticResource StatusText}" MaxWidth="560" Text="{Binding Document.FilePath}"
                               Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}, ConverterParameter={x:Static controls:VisibilityParameters.Invert}}"
                               AutomationProperties.AutomationId="DocumentPathText" />
                    <Border Style="{StaticResource StatusSegment}"
                            Visibility="{Binding Document.EncodingText, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Style="{StaticResource StatusText}" Text="{Binding Document.EncodingText}"
                                   AutomationProperties.AutomationId="EncodingText" />
                    </Border>
                    <Border Style="{StaticResource StatusSegment}"
                            Visibility="{Binding Document.LineEndingText, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Style="{StaticResource StatusText}" Text="{Binding Document.LineEndingText}" />
                    </Border>
                    <Border Style="{StaticResource StatusSegment}"
                            Visibility="{Binding Document.SizeText, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Style="{StaticResource StatusText}" Text="{Binding Document.SizeText}" />
                    </Border>
                    <Border Style="{StaticResource StatusSegment}"
                            Visibility="{Binding Document.LastWriteText, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Style="{StaticResource StatusText}" Text="{Binding Document.LastWriteText}" />
                    </Border>
                    <Border Style="{StaticResource StatusSegment}"
                            Visibility="{Binding Document.Notice, Converter={StaticResource NullToVisibility}}">
                        <TextBlock Style="{StaticResource StatusText}" Foreground="{DynamicResource Status.Danger}"
                                   Text="{Binding Document.Notice}" AutomationProperties.AutomationId="DocumentNotice" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>

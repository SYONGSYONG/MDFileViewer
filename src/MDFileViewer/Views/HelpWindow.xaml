<!--
  도움말·릴리즈 노트 창 (.claude/03-design.md §2.4): 왼쪽 목차(WPF 목록), 오른쪽 메인 뷰어와 같은 렌더러·CSS의 문서. 모달리스, 기본 900×700.
  제목·AutomationId·목록 이름은 문서마다 달라 코드에서 정한다.
-->
<Window x:Class="MDFileViewer.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:MDFileViewer.Core;assembly=MDFileViewer.Core"
        xmlns:controls="clr-namespace:MDFileViewer.Controls"
        Icon="pack://application:,,,/Assets/app.ico"
        Width="900" Height="700" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Surface.Chrome}"
        Foreground="{DynamicResource Text.Primary}"
        FontFamily="{StaticResource Font.Ui}" FontSize="13">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" MinWidth="160" />
            <ColumnDefinition Width="6" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="Contents" Grid.Column="0" Background="{DynamicResource Surface.Panel}" Foreground="{DynamicResource Text.Primary}"
                 BorderThickness="0" Padding="0,8" DisplayMemberPath="Title" SelectionChanged="OnSectionSelected"
                 AutomationProperties.AutomationId="HelpContents">
            <ListBox.ItemContainerStyle>
                <!-- 이름을 주지 않으면 화면 읽기 프로그램이 항목을 레코드의 ToString()("HelpSection { Title = … }")으로 읽는다 -->
                <Style TargetType="ListBoxItem">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <GridSplitter Grid.Column="1" Style="{StaticResource PaneSplitter}" />

        <controls:MarkdownView x:Name="HelpViewer" Grid.Column="2" AutomationProperties.AutomationId="HelpViewer" />
    </Grid>
</Window>

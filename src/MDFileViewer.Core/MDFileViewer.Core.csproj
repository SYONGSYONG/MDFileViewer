<Project Sdk="Microsoft.NET.Sdk">

  <!-- 셸 통합이 레지스트리(Windows 전용 API)를 쓰므로 -windows 대상이지만 WPF는 쓰지 않는다 (.claude/02-specs.md §3) -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>MDFileViewer.Core</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>

  <!-- 지연 로딩이 끝나기를 테스트가 기다릴 수 있게 내부 Task를 보여 준다(앱 코드는 쓰지 않는다) -->
  <ItemGroup>
    <InternalsVisibleTo Include="MDFileViewer.Core.Tests" />
  </ItemGroup>

  <!-- WebView2 가상 호스트(appassets.example)가 출력 폴더의 Resources를 매핑한다 (.claude/02-specs.md §6.2).
       참조하는 앱·테스트 프로젝트의 출력 폴더에도 같은 경로로 복사된다. -->
  <ItemGroup>
    <None Update="Resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
